# Copy to .env (gitignored). Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase -> Project Settings -> Database). Used for all table access.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
ANTHROPIC_API_KEY=
# Model IDs are never hard-coded; choose them here.
SUMMARY_MODEL=
EXTRACTION_MODEL=
# faster-whisper model size/name (local transcription, no API key)
WHISPER_MODEL=small
AUDIO_BUCKET=meeting-audio
# What tasks.owner_code refers to: seat | person | mixed (see docs/SCHEMA_NOTES.md)
OWNER_CODE_KIND=seat

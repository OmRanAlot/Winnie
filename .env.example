# Loaded by the backend from the repository root. Never put secrets in frontend/.env.
WINNIE_APP_NAME=Winnie API
WINNIE_ENVIRONMENT=development
WINNIE_CORS_ORIGINS=["http://localhost:5173"]

# Supabase task store (Project Settings -> API). Server-side secret: never in frontend/.env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional for local development; required before exposing task endpoints elsewhere.
WINNIE_TASK_API_KEY=
# Same private value as MESSAGING_BRIDGE_SECRET in messaging/.env.
WINNIE_MESSAGING_BRIDGE_SECRET=
WINNIE_ACTIVE_SEMESTER=fall-2026
# Live Google Sheets sync: server-only credentials and explicit active tracker sources.
# See docs/GOOGLE_SHEETS_SYNC.md for initial setup and monthly/semester rollover.
# Use a service-account file outside git, or leave unset to use Google ADC.
# WINNIE_SHEETS_CREDENTIALS_FILE=C:/private/winnie-sheets-service-account.json
WINNIE_SHEET_SYNC_SOURCES=[]
WINNIE_SHEET_SYNC_INTERVAL_SECONDS=300
WINNIE_MESSAGE_AI_ENABLED=false
# Empty uses the existing GEMINI_MODEL. Requires GEMINI_API_KEY on the backend.
WINNIE_MESSAGE_AI_MODEL=
WINNIE_MESSAGE_AI_TIMEOUT_SECONDS=10
WINNIE_REMINDERS_ENABLED=false
WINNIE_REMINDER_TRANSPORT=mock
WINNIE_REMINDER_TIMEZONE=America/New_York
WINNIE_REMINDER_DAYTIME_HOUR=9
WINNIE_REMINDER_EVENING_HOUR=18
WINNIE_HELP_WORKFLOW_ENABLED=false
WINNIE_HELP_GROUPS_ENABLED=false
# Private operator key for dashboard approvals. Not a VITE_ variable.
WINNIE_HELP_ADMIN_API_KEY=

# FUTURE settings: documented placeholders, not consumed by the starter API.
# Keep mock mode as the default when implementing adapters.
DATA_PROVIDER=memory
MESSAGING_PROVIDER=mock
AGENT_PROVIDER=mock
APP_TIMEZONE=America/New_York
PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# LLM: select and pin a supported provider/model during the integration spike.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Azure Cosmos DB for NoSQL; select managed identity or a server-side key later.
COSMOS_ENDPOINT=
COSMOS_DATABASE=winnie
COSMOS_CONTAINER=board-data
COSMOS_KEY=

# Photon: names are our placeholders, not a verified provider SDK contract.
# Confirm the actual API, auth, inbound transport, and sender provisioning first.
PHOTON_API_KEY=
PHOTON_SENDER_ID=
PHOTON_WEBHOOK_SECRET=

# Reminder worker defaults to implement; run one scheduler process initially.
REMINDER_SCAN_INTERVAL_SECONDS=60
REMINDER_EVENING_HOUR=18

# Stretch: email provider, OAuth, audio transcription, and durable agent state.
# Add provider-specific credentials only after selecting the real integrations.

# Event planning: mock is a historical checklist; deepagents analyzes the idea.
WINNIE_PLANNING_MODE=mock
WINNIE_PLANNING_MODEL=
# Gemini option: google_genai:gemini-4-hydrogen (or your enabled Gemini model ID).
GEMINI_API_KEY=
WINNIE_PLANNING_KNOWLEDGE_PATH=backend/data/planning/fall-2026.json
WINNIE_PLANNING_TIMEOUT_SECONDS=60
WINNIE_PLANNING_PIPELINE_TIMEOUT_SECONDS=180
WINNIE_PLANNING_RUNS_PATH=backend/data/planning/runs.sqlite3
# Required for approve/reject, even in development. Use a separate random local secret.
WINNIE_PLANNING_REVIEW_API_KEY=
WINNIE_PLANNING_TAXONOMY_PATH=backend/data/planning/spring-2027-taxonomy.json
WINNIE_PLANNING_HISTORY_SEMESTER=fall-2026
# Optional verified role-holder mappings by semester (private JSON); see the planning guide.
# WINNIE_PLANNING_ROSTER_PATH=backend/data/planning/rosters.json
# For OpenAI, export OPENAI_API_KEY in the API process environment. See docs/EVENT_PLANNING.md.

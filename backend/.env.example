# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Database (TBD — SQLite for local dev)
DATABASE_URL=sqlite:///./winnie.db

# Google (Sheets task tracker + Docs meeting notes)
GOOGLE_SERVICE_ACCOUNT_FILE=
TASK_TRACKER_SHEET_ID=
MEETING_NOTES_FOLDER_ID=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Shared inbox (provider TBD)
SHARED_INBOX_ADDRESS=

# Messaging sidecar (messaging/) — secret must match messaging/.env
MESSAGING_SIDECAR_URL=http://localhost:4000
MESSAGING_WEBHOOK_SECRET=

# Meeting transcription (provider TBD)
TRANSCRIPTION_API_KEY=

# Behaviour tuning
EMAIL_REMINDER_AFTER_HOURS=24
DEADLINE_WARNING_DAYS=3

GEMINI_API_KEY=

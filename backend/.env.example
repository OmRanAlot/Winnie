# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Database (TBD — SQLite for local dev)
DATABASE_URL=sqlite:///./winnie.db

# Google (Sheets task tracker + Docs meeting notes)
GOOGLE_SERVICE_ACCOUNT_FILE=
TASK_TRACKER_SHEET_ID=
MEETING_NOTES_FOLDER_ID=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Shared inbox (provider TBD)
SHARED_INBOX_ADDRESS=

# Messaging sidecar (messaging/) — secret must match messaging/.env
MESSAGING_SIDECAR_URL=http://localhost:4000
MESSAGING_WEBHOOK_SECRET=

# Meeting transcription (provider TBD)
TRANSCRIPTION_API_KEY=

# Behaviour tuning
EMAIL_REMINDER_AFTER_HOURS=24
DEADLINE_WARNING_DAYS=3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

WINNIE_TASK_TRANSCRIPT_SOURCE=example
# Supabase task store (Project Settings -> API in the Supabase dashboard).
# The secret key is server-only: never put it in frontend/.env or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Only needed by the Supabase CLI (`supabase db push`), not by the backend.
SUPABASE_DB_PWD=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted.

# Messaging/reminders; see docs/REMINDERS.md and docs/HELP_WORKFLOW.md.
WINNIE_MESSAGING_BRIDGE_SECRET=
WINNIE_ACTIVE_SEMESTER=fall-2026
WINNIE_MESSAGE_AI_ENABLED=false
WINNIE_REMINDERS_ENABLED=false
WINNIE_REMINDER_TRANSPORT=mock
WINNIE_REMINDER_TIMEZONE=America/New_York
WINNIE_REMINDER_DAYTIME_HOUR=9
WINNIE_REMINDER_EVENING_HOUR=18
WINNIE_HELP_WORKFLOW_ENABLED=false
WINNIE_HELP_GROUPS_ENABLED=false
WINNIE_HELP_ADMIN_API_KEY=

# Durable event-plan generation and review (docs/PLANNING_RUNS.md).
WINNIE_PLANNING_RUNS_PATH=backend/data/planning/runs.sqlite3
WINNIE_PLANNING_REVIEW_API_KEY=


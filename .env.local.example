# LOCAL MODE. Copy to .env.local (repo root). Loaded after .env, so it overrides it.
# Gitignored and excluded from Docker/gcloud builds: it can never ship to Cloud Run.
# The deployed service gets its config from Cloud Run env + Secret Manager only.
WINNIE_MODE=local
WINNIE_LOG_LEVEL=DEBUG
WINNIE_CORS_ORIGINS=["http://localhost:5173"]

# Local Supabase: `npx supabase start`, then copy the keys from `npx supabase status`.
# The backend refuses to start in local mode if this host isn't localhost/127.0.0.1.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Use a throwaway value locally, not the production secret.
WINNIE_MESSAGING_BRIDGE_SECRET=local-dev-secret

# Optional: your own dev Gemini key, so local testing doesn't use the deployed key's quota.
GEMINI_API_KEY=

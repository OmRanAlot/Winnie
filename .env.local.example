# LOCAL MODE. Copy to .env.local (repo root). Loaded after .env/backend/.env, so it overrides them.
# Gitignored and excluded from Docker/gcloud builds: it can never ship to Cloud Run.
# The deployed service gets its config from Cloud Run env + Secret Manager only.
#
# Supabase (hosted API), Gemini and everything else keep coming from your existing .env.
# Only put a variable here when you want a different value while testing locally.
# Never leave a variable blank here: a blank value overrides the real one from .env.
WINNIE_MODE=local
WINNIE_LOG_LEVEL=DEBUG
WINNIE_CORS_ORIGINS=["http://localhost:5173"]

# Optional overrides, e.g. a separate dev Gemini key so local testing doesn't use the deployed key's quota:
# GEMINI_API_KEY=

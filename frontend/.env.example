# Leave as /api to use the Vite proxy to http://localhost:8000. For a separate API host, include /api.
VITE_API_BASE_URL=/api

# Supabase Auth: use the same project as backend/.env. Never use a secret/service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

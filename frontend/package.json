{
  "name": "winnie-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localdev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:auth": "vitest run tests/auth-ui.spec.jsx --environment jsdom",
    "test:ui": "vitest run tests/auth-ui.spec.jsx tests/dashboard-ui.spec.jsx tests/attendance-ui.spec.jsx tests/sheet-sync-ui.spec.jsx --environment jsdom"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

# Local mode. Copy to frontend/.env.localdev and run `npm run dev:local`.
# Only read with `vite --mode localdev`, never by `vite build`, so it can't leak into a deploy.
VITE_API_BASE_URL=/api

# Local Supabase (`npx supabase start`); publishable/anon key comes from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local mode. Copy to frontend/.env.localdev and run `npm run dev:local`.
# Only read with `vite --mode localdev`, never by `vite build`, so it can't leak into a deploy.
VITE_API_BASE_URL=/api

# Same hosted Supabase project as the backend. Publishable key only, never the secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
